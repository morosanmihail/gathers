# syntax=docker/dockerfile:1
FROM rust:1.92-slim-bookworm AS builder

RUN apt-get update && apt-get install -y --no-install-recommends \
      build-essential libsqlite3-dev pkg-config \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app
COPY . .

RUN --mount=type=cache,target=/app/target \
    --mount=type=cache,target=/usr/local/cargo/registry \
    cargo build --release --locked --bin mirror \
    && cp target/release/mirror /mirror-bin

FROM ubuntu:24.04

RUN apt-get update && apt-get install -y --no-install-recommends \
      ca-certificates libsqlite3-0 bzip2 \
    && rm -rf /var/lib/apt/lists/*

RUN useradd --create-home --shell /bin/bash app
USER app
WORKDIR /home/app

RUN mkdir -p /home/app/.local/share/gathers/mirror

COPY --from=builder /mirror-bin ./mirror

EXPOSE 5235

ENV MIRROR_DATA_DIR=/home/app/.local/share/gathers/mirror

ENTRYPOINT ["/home/app/mirror"]
