{
  "name": "gathers-webui2",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "generate-types": "mkdir -p src/lib/generated && cargo run --manifest-path ../Cargo.toml --bin server -- --print-schema > src/lib/generated/openapi.json && npx openapi-typescript src/lib/generated/openapi.json -o src/lib/generated/api.d.ts"
  },
  "overrides": {
    "cookie": "^0.7.0"
  },
  "devDependencies": {
    "@sveltejs/adapter-static": "^3.0.10",
    "@sveltejs/kit": "^2.70.3",
    "@sveltejs/vite-plugin-svelte": "^7.3.0",
    "@types/node": "^26.6.1",
    "openapi-typescript": "^7.13.0",
    "svelte": "^5.57.0",
    "svelte-check": "^4.7.6",
    "typescript": "^5.9.3",
    "vite": "^8.3.0"
  }
}
